#!/usr/bin/env zsh
# ghostwriter-namer -- background worker for ghostwriter
#
# Invoked asynchronously by ghostwriter.plugin.zsh. Reads a context
# snapshot (cwd, previous title, recent commands), asks the AI for a short
# tab title, and writes it to the tab's tty via an OSC 2 escape sequence.
#
#   ghostwriter-namer --session-dir DIR --tty /dev/ttysNNN --gen N [--fresh]
#
# Never blocks the shell: the plugin spawns this fully detached.

emulate -L zsh
setopt extended_glob
zmodload -F zsh/stat b:zstat 2>/dev/null
zmodload zsh/datetime 2>/dev/null
zmodload zsh/system 2>/dev/null

# ---------------------------------------------------------------------------
# Args & config
# ---------------------------------------------------------------------------
local session_dir="" tty="" gen=0 fresh=0
while (( $# )); do
    case "$1" in
        --session-dir) session_dir="$2"; shift 2 ;;
        --tty)         tty="$2";         shift 2 ;;
        --gen)         gen="$2";         shift 2 ;;
        --fresh)       fresh=1;          shift   ;;
        *)             shift ;;
    esac
done
[[ -n "$session_dir" && -n "$tty" ]] || exit 1

local cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/ghostwriter"
mkdir -p "$cache_root" 2>/dev/null
local backend="${GHOSTWRITER_BACKEND:-}"
local model="${GHOSTWRITER_MODEL:-}"
local api_key="${GHOSTWRITER_API_KEY:-}"
local base_url="${GHOSTWRITER_BASE_URL:-}"
local curl_bin="${GHOSTWRITER_CURL:-curl}"
[[ "$backend" == (openai|anthropic|openrouter) ]] || exit 1
if [[ -z "$api_key" ]]; then
    case "$backend" in
        openai)     api_key="${OPENAI_API_KEY:-}" ;;
        anthropic)  api_key="${ANTHROPIC_API_KEY:-}" ;;
        openrouter) api_key="${OPENROUTER_API_KEY:-}" ;;
    esac
fi
[[ -n "$api_key" ]] || exit 1
if [[ -z "$model" ]]; then
    case "$backend" in
        openai)     model="gpt-5-nano" ;;
        anthropic)  model="claude-haiku-4-5" ;;
        openrouter) model="anthropic/claude-haiku-4.5" ;;
    esac
fi
local -i max_len="${GHOSTWRITER_MAX_LEN:-32}"
local -i timeout="${GHOSTWRITER_TIMEOUT:-45}"
local debug="${GHOSTWRITER_DEBUG:-}"
# "low" rather than "minimal": at minimal effort gpt-5-nano gets noticeably
# sloppier about the prompt's rules (especially keeping a still-accurate
# previous title unchanged), which shows up as titles flapping between
# rewordings. "low" keeps most of the cost savings without that.
local reasoning="${GHOSTWRITER_REASONING:-low}"

# Scratch files, cleaned up on every exit path so a killed worker (closed
# tab, logout) leaves nothing behind in the cache directory.
local out_file="$session_dir/out.$$"
local body_file="$session_dir/body.$$"
trap 'rm -f "$out_file" "$body_file"' EXIT INT TERM HUP

log() { [[ -n "$debug" ]] && print -r -- "$(date '+%F %T') [$$] $*" 2>/dev/null >>| "$cache_root/debug.log"; return 0 }
local err_target=/dev/null
[[ -n "$debug" ]] && err_target="$cache_root/debug.log"

# ---------------------------------------------------------------------------
# Read context snapshot written by the plugin
# ---------------------------------------------------------------------------
local ctx_file="$session_dir/context.$gen"
[[ -r "$ctx_file" ]] || { log "no context file $ctx_file"; exit 0 }

local cwd="" prev="" line key val
local -a cmds
while IFS= read -r line; do
    key="${line%%	*}" val="${line#*	}"
    case "$key" in
        cwd)  cwd="$val" ;;
        prev) prev="$val" ;;
        cmd)  cmds+=("$val") ;;
    esac
done < "$ctx_file"
rm -f "$ctx_file"
[[ -n "$cwd" ]] || exit 0

# Bail out early if the user pinned a manual title.
[[ -e "$session_dir/pin" ]] && { log "pinned; skip"; exit 0 }

log "gen=$gen fresh=$fresh cwd=$cwd cmds=${#cmds} prev='$prev'"

# ---------------------------------------------------------------------------
# Git context + cache key
# ---------------------------------------------------------------------------
local repo="" branch="" ctx_key="$cwd"
if builtin cd -q "$cwd" 2>/dev/null; then
    local root
    if root=$(command git rev-parse --show-toplevel 2>/dev/null); then
        repo="${root:t}" ctx_key="$root"
        branch=$(command git rev-parse --abbrev-ref HEAD 2>/dev/null) || branch=""
        # The default branch is the assumed state; mentioning it only tempts
        # the model into spending the title on "Main" or "Main Branch".
        [[ "$branch" == (main|master|trunk|HEAD) ]] && branch=""
    fi
fi

# The house casing rule, shared with the plugin's provisional titles so an
# AI name never looks different from the folder name it replaces: separators
# become spaces, a one-word title stays lowercase ("ghostwriter"), and a
# longer one capitalizes its first word only ("Naders portfolio").
_pretty_name() {
    local -a words=( ${(L)${(s: :)${1//[-_.]/ }}} )
    local out="${(j: :)words}"
    (( ${#words} > 1 )) && out="${(U)out[1]}${out[2,-1]}"
    print -r -- "${out:-$1}"
}

_hash() {
    if command -v md5 >/dev/null 2>&1;        then command md5 -q -s "$1"
    elif command -v md5sum >/dev/null 2>&1;   then print -rn -- "$1" | command md5sum | cut -d' ' -f1
    else print -rn -- "${1//\//_}"; fi
}
local cache_dir="$cache_root/repo-cache"
local cache_file="$cache_dir/$(_hash "$ctx_key")"
mkdir -p "$cache_dir" 2>/dev/null || true

# Apply a title to the tab, unless a newer rename or a manual pin won the
# race meanwhile. Also records the title in the per-session context map so
# the plugin can restore it instantly when this context is revisited.
_apply_title() {  # $1 = title
    (
        local applied=0 lock_fd
        if (( ${+builtins[zsystem]} )); then
            zsystem flock -f lock_fd "$session_dir/apply.lock" 2>/dev/null || exit 1
        fi
        [[ -r "$session_dir/applied_gen" ]] && applied="$(<$session_dir/applied_gen)"
        (( applied > gen )) && { log "gen $gen outdated (applied $applied)"; exit 1 }
        [[ -e "$session_dir/pin" ]] && { log "pinned meanwhile; skip"; exit 1 }
        [[ -w "$tty" ]] || exit 1
        printf '\033]2;%s\007' "$1" > "$tty"
        print -r -- "$gen" >| "$session_dir/applied_gen"
        print -r -- "$1"   >| "$session_dir/title"

        local map_file="$session_dir/ctx-titles"
        local -a map_lines
        [[ -r "$map_file" ]] && map_lines=("${(@f)$(<$map_file)}")
        map_lines=("${(@)map_lines:#${(b)ctx_key}	*}")
        map_lines+=("$ctx_key	$1")
        (( ${#map_lines} > 20 )) && map_lines=("${(@)map_lines[-20,-1]}")
        print -rl -- "${map_lines[@]}" 2>/dev/null >| "$map_file.$$" && \
            command mv -f "$map_file.$$" "$map_file" 2>/dev/null
        log "applied gen=$gen title='$1'"
    ) || return 1
    return 0
}

# A non-repo directory nothing has run in gives the AI nothing to work with;
# guessing from the path alone produces boilerplate ("X Project Root") that
# then sticks to tabs merely passing through. A plain directory title is more
# honest than a guess. (In a repo the repo name itself is enough signal.)
if (( ${#cmds} == 0 )) && [[ -z "$repo" ]]; then
    log "no signal (no commands, no repo, at $cwd); using basename"
    _apply_title "$(_pretty_name "${cwd:t}")"
    exit 0
fi

# ---------------------------------------------------------------------------
# Get a title: repo cache (fresh tabs only) or AI call
# ---------------------------------------------------------------------------
local title="" from_cache=0

# The cross-tab cache holds one name per *repo*; non-repo directories are too
# transient to be worth remembering (and too easy to pollute).
if (( fresh )) && [[ -n "$repo" && -r "$cache_file" ]]; then
    local -A st
    if zstat -H st +mtime "$cache_file" 2>/dev/null && \
       (( EPOCHSECONDS - st[mtime] < 7 * 86400 )); then
        title="$(<$cache_file)" from_cache=1
        log "cache hit: '$title'"
    fi
fi

if [[ -z "$title" ]]; then
    # Redact obvious secrets before anything leaves the machine.
    local cmds_text=""
    if (( ${#cmds} )); then
        # The optional scheme keeps "Authorization: Bearer <token>" from
        # redacting the word "Bearer" and letting the token itself through.
        cmds_text=$(print -rl -- "${cmds[@]}" | command perl -pe '
            s/((?:api[_-]?key|access[_-]?key|secret|token|password|passwd|credential|authorization|bearer)\s*[=: ]\s*(?:bearer\s+|token\s+)?)\S+/${1}[REDACTED]/gi;
            s/[A-Za-z0-9_+\/=-]{40,}/[REDACTED]/g;
        ' 2>/dev/null) || cmds_text=""
    fi

    local display_cwd="${cwd/#$HOME/~}"
    local prompt="You name terminal tab titles. Reply with ONLY the title text: at most 4 words, at most $max_len characters, no quotes, no trailing punctuation, no explanations.

Guidelines:
- Default to the project name alone, tidied up: split hyphens and underscores into separate words, and restore an apostrophe where the name is clearly possessive -- a repo named \"janes-ledger\" is titled \"Jane's ledger\".
- Capitalization: a one-word title is all lowercase (\"ledger\"); a title of two or more words capitalizes only the first word (\"Jane's ledger\"). Never use Title Case.
- Keep it short and plain. Do not describe what the project is or does, and do not pad the name with filler like \"Dev\", \"Work\", \"Session\", or \"Project\".
- Only if the project name is unclear or missing, describe the current activity instead, in 2-4 words.
- Base the title ONLY on the context below; never reuse the example name above.
- If the previous title still fits, reply with it EXACTLY unchanged.

Context:
Directory: $display_cwd"
    [[ -n "$repo" ]]   && prompt+=$'\n'"Git repo: $repo${branch:+ (branch: $branch)}"
    [[ -n "$prev" ]]   && prompt+=$'\n'"Previous title: $prev"
    if [[ -n "$cmds_text" ]]; then
        prompt+=$'\n'"Recent commands, oldest first:"$'\n'"$cmds_text"
    else
        prompt+=$'\n'"No commands yet -- the tab was just opened here."
    fi

    # Build the request for the selected backend. The prompt travels via
    # stdin into perl's JSON encoder, so no shell quoting can corrupt it.
    local url
    case "$backend" in
        openai)     url="${base_url:-https://api.openai.com/v1}/chat/completions" ;;
        openrouter) url="${base_url:-https://openrouter.ai/api/v1}/chat/completions" ;;
        anthropic)  url="${base_url:-https://api.anthropic.com/v1}/messages" ;;
    esac
    if ! print -r -- "$prompt" | command perl -MJSON::PP -0777 -e '
        my $prompt = <STDIN>;
        my ($backend, $model, $reasoning) = @ARGV;
        my $msgs = [ { role => "user", content => $prompt } ];
        my $body =
            $backend eq "anthropic"
                ? { model => $model, max_tokens => 64, messages => $msgs }
            : $backend eq "openai"
                # Generous cap: reasoning models spend completion tokens
                # thinking before they emit the title.
                ? { model => $model, max_completion_tokens => 1000, messages => $msgs }
                : { model => $model, max_tokens => 1000, messages => $msgs };
        # Naming a tab needs no deliberation, but the gpt-5 family reasons at
        # medium effort by default -- slower and several times the cost for an
        # identical three-word answer. gpt-5.1 and later reason lazily already
        # and reject "minimal", so only the original gpt-5 line is capped.
        $body->{reasoning_effort} = $reasoning
            if $backend eq "openai" && $reasoning ne "off" && $model =~ /^gpt-5(?:-|$)/;
        print JSON::PP->new->canonical->encode($body);
    ' "$backend" "$model" "$reasoning" >| "$body_file" 2>>| "$err_target"; then
        log "failed to build request body"
        exit 0
    fi
    # Headers are piped into curl's --config, so the API key is never written
    # to disk and never appears in the process arguments (`ps`).
    local esc_key="${${api_key//\\/\\\\}//\"/\\\"}"
    # --max-time bounds the whole operation (DNS included), so no watchdog of
    # our own is needed; we are already detached from the shell.
    local -i rc=0
    {
        print -r -- 'header = "content-type: application/json"'
        if [[ "$backend" == anthropic ]]; then
            print -r -- "header = \"x-api-key: $esc_key\""
            print -r -- 'header = "anthropic-version: 2023-06-01"'
        else
            print -r -- "header = \"Authorization: Bearer $esc_key\""
        fi
        [[ "$backend" == openrouter ]] && print -r -- 'header = "X-Title: ghostwriter"'
    } | command "$curl_bin" -sS --fail --max-time "$timeout" --config - \
        --data-binary @"$body_file" "$url" \
        >| "$out_file" 2>>| "$err_target"
    rc=${pipestatus[2]}
    rm -f "$body_file"

    # A failed request carries an error payload, not a title (curl --fail
    # discards non-2xx bodies); only parse the response on success.
    local out=""
    if (( rc == 0 )) && [[ -r "$out_file" ]]; then
        out=$(command perl -MJSON::PP -0777 -e '
            my $d = eval { decode_json(<STDIN>) } or exit 1;
            my $t;
            if ($ARGV[0] eq "anthropic") {
                for my $b (@{ $d->{content} || [] }) {
                    if (($b->{type} // "") eq "text") { $t = $b->{text}; last }
                }
            } else {
                $t = eval { $d->{choices}[0]{message}{content} };
            }
            defined $t && length $t or exit 1;
            print $t;
        ' "$backend" < "$out_file" 2>>| "$err_target") || {
            out=""
            local resp_head="$(<$out_file)"
            log "unparseable API response: ${resp_head[1,200]}"
        }
    else
        log "API call failed rc=$rc; discarding output"
    fi
    rm -f "$out_file"

    # Sanitize: first non-empty line, no control chars/quotes, trimmed, capped.
    for line in ${(f)out}; do
        line="${line//[$'\x00'-$'\x1f'$'\x7f']/}"
        line="${line##[[:space:]]#}" line="${line%%[[:space:]]#}"
        [[ -n "$line" ]] && { title="$line"; break }
    done
    while [[ "$title" == [\"\'\`]*[\"\'\`] && ${#title} -ge 2 ]]; do
        title="${title[2,-2]}"
    done
    while [[ "$title" == *"  "* ]]; do title="${title//  / }"; done
    title="${title##[[:space:]]#}" title="${title%%[[:space:]]#}"
    # Models drift back to Title Case however the prompt is worded, so the
    # casing rule is applied here rather than merely asked for.
    title="$(_pretty_name "$title")"
    if (( ${#title} > max_len )); then
        title="${title[1,max_len]}"
        [[ "$title" == *" "* ]] && title="${title% *}"   # drop cut-off word
        title="${title%%[[:space:]]#}"
    fi
    log "AI raw->sanitized: '$title'"
fi

# Fallbacks: keep an existing title rather than degrading it.
if [[ -z "$title" ]]; then
    if [[ -n "$prev" ]]; then log "AI failed; keeping '$prev'"; exit 0
    else title="$(_pretty_name "${cwd:t}")"; log "AI failed; fallback '$title'"; fi
fi

# ---------------------------------------------------------------------------
# Apply (unless outdated or pinned meanwhile)
# ---------------------------------------------------------------------------
if _apply_title "$title"; then
    # Refresh the fresh-tab cache with newly generated names. Written via
    # rename so concurrent tabs in one repo can't read a half-written title.
    if (( fresh && ! from_cache )) && [[ -n "$repo" ]]; then
        print -r -- "$title" >| "$cache_file.$$" 2>/dev/null && \
            command mv -f "$cache_file.$$" "$cache_file" 2>/dev/null || \
            rm -f "$cache_file.$$" 2>/dev/null
    fi
fi

# ---------------------------------------------------------------------------
# Opportunistic cleanup of stale session dirs (at most once a day)
# ---------------------------------------------------------------------------
local marker="$cache_root/last-cleanup" do_clean=1
if [[ -e "$marker" ]]; then
    local -A mst
    zstat -H mst +mtime "$marker" 2>/dev/null && \
        (( EPOCHSECONDS - mst[mtime] < 86400 )) && do_clean=0
fi
if (( do_clean )); then
    touch "$marker" 2>/dev/null || true
    command find "$cache_root/sessions" -mindepth 1 -maxdepth 1 -type d \
        -mtime +7 -exec rm -rf {} + 2>/dev/null || true
    # Scratch files from workers that were killed outright (SIGKILL runs no
    # trap), including header files left by pre-1.0 versions.
    command find "$cache_root/sessions" -mindepth 2 -maxdepth 2 -type f \
        \( -name 'out.*' -o -name 'body.*' -o -name 'hdr.*' -o -name 'context.*' \) \
        -mtime +1 -exec rm -f {} + 2>/dev/null || true
    log "cleaned stale sessions"
fi
exit 0
